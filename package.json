{
  "name": "st-workspace-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "pnpm -r build && vitest run",
    "test:coverage": "pnpm -r build && vitest run --coverage",
    "agent:lint": "tsx tools/agent-lint.ts",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "3.2.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
