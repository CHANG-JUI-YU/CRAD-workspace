{
  "name": "st-workspace-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "typecheck:only": "pnpm -r typecheck",
    "lint": "pnpm build && pnpm lint:only",
    "lint:only": "tsx tools/typed-lint.ts",
    "test": "pnpm build && pnpm test:only",
    "test:only": "vitest run",
    "test:coverage": "pnpm build && pnpm test:coverage:only",
    "test:coverage:only": "vitest run --coverage",
    "test:tools:coverage": "pnpm build && pnpm test:tools:coverage:only",
    "test:tools:coverage:only": "vitest run --config vitest.tools.config.ts --coverage",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "audit:truncation": "tsx tools/audit-truncation-scan.ts",
    "agent:lint": "tsx tools/agent-lint.ts",
    "quality:correctness:only": "tsx tools/quality-gates.ts ci-correctness",
    "quality:coverage:only": "tsx tools/quality-gates.ts ci-coverage",
    "quality:dependency-audit:only": "tsx tools/quality-gates.ts ci-dependency-audit",
    "verify": "tsx tools/quality-gates.ts local",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm typecheck:only && pnpm test:only"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "3.2.7",
    "jsonc-parser": "3.3.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7",
    "yaml": "2.8.1"
  }
}
